config_version=5

[application]

config/name="Metrum Rise"
config/features=PackedStringArray("4.x", "Forward Plus")
run/main_scene="res://scenes/Router.tscn"

[autoload]

LaunchState="*res://scripts/core/launch_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_screen=0
window/stretch/mode="disabled"

[rendering]

environment/defaults/default_clear_color=Color(0.53, 0.74, 0.92, 1)
environment/defaults/default_environment="res://default_environment.tres"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
