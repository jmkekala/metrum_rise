[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://bin/libmetrum_rise.so"
linux.release.x86_64 = "res://bin/libmetrum_rise.so"
windows.debug.x86_64 = "res://bin/metrum_rise.dll"
windows.release.x86_64 = "res://bin/metrum_rise.dll"
macos.debug = "res://bin/libmetrum_rise.dylib"
macos.release = "res://bin/libmetrum_rise.dylib"
