## Correlation, bounded storage, payload accounting and cancellation regression for ROAD-30.
extends SceneTree

const Trace := preload("res://scripts/benchmarks/road_preview_metrics.gd")

func _initialize() -> void:
	var trace := Trace.new()
	var points := PackedVector3Array([Vector3.ZERO, Vector3.ONE])
	var now := Time.get_ticks_usec()
	trace.sample(points, now)
	trace.sample(points, now + 1)
	assert(trace.input_id == 1 and trace.input_us == now)
	trace.dispatch(10, now + 2, now + 3, true)
	trace.poll(10, 50, {"vertices": points, "indices": PackedInt32Array([0, 1]), "nested": [{"bytes": PackedByteArray([1, 2, 3])}]})
	assert(trace.request(10).packed_bytes == 35)
	trace.installed(10)
	trace.sample(PackedVector3Array([Vector3.ZERO, Vector3(2, 0, 0)]), Time.get_ticks_usec())
	trace.frame(10, true)
	assert(trace.rows.size() == 1 and not trace.last_rendered.exact_at_frame)
	assert(trace.last_rendered.request_id == 10 and trace.last_rendered.input_id == 1)
	assert(trace.last_rendered.input_to_frame_ms >= trace.last_rendered.input_to_install_ms)
	trace.frame(10, true)
	assert(trace.rows.size() == 1, "idle frames must not duplicate a displayed request")
	assert(trace.display_age_samples.size() == 2)
	assert(trace.display_age_samples[1].age_ms >= trace.display_age_samples[0].age_ms)
	trace.dispatch(11, now, now, false)
	trace.installed(11)
	trace.frame(0, true)
	assert(trace.rows.size() == 1, "cancelled installations must not count as rendered")
	for id in range(12, 30):
		trace.dispatch(id, now, now, false)
	assert(trace._requests.size() <= 8)
	trace.rows.resize(Trace.CAPACITY)
	trace.installed(29)
	trace.frame(29, false)
	assert(trace.dropped == 1 and trace.rows.size() == Trace.CAPACITY)
	assert(trace.last_rendered.frame_boundary == "headless_process_frame")
	trace.frame_ms.resize(Trace.CAPACITY)
	trace.frame(29, false)
	assert(trace.dropped_frames > 0, "frame saturation must not silently truncate acceptance")

	var lifecycle_trace := Trace.new()
	var lifecycle_now := Time.get_ticks_usec()
	lifecycle_trace.schedule(lifecycle_now - 2000, lifecycle_now - 1900)
	lifecycle_trace.schedule(lifecycle_now - 1000, lifecycle_now - 900)
	lifecycle_trace.sample(points, lifecycle_now - 800)
	lifecycle_trace.dispatch(1, lifecycle_now - 700, lifecycle_now - 600, true)
	# A newer sampled pose makes request 1 stale even though it reaches a frame within budget.
	lifecycle_trace.schedule(lifecycle_now - 500, lifecycle_now - 450)
	lifecycle_trace.sample(PackedVector3Array([Vector3.ZERO, Vector3(2, 0, 0)]), lifecycle_now - 400)
	lifecycle_trace.installed(1)
	lifecycle_trace.frame(1, false)
	lifecycle_trace.dispatch(2, lifecycle_now - 300, lifecycle_now - 200, true)
	lifecycle_trace.forget(2)
	lifecycle_trace.finish_scheduled_inputs(Time.get_ticks_usec())
	var lifecycle: Array = lifecycle_trace.scheduled_input_lifecycle()
	assert(lifecycle.size() == 3)
	assert(lifecycle[0].disposition == "coalesced_before_sampling")
	assert(lifecycle[1].disposition == "stale_displayed")
	assert(lifecycle[1].sample_to_stale_frame_ms < 16.7)
	assert(not lifecycle[1].strict_16_7_met, "a fast stale result must miss the exact-pose deadline")
	assert(lifecycle[2].disposition == "sampled_but_superseded")
	assert(lifecycle[2].forgotten_request_count == 1, "lost requests must be visible independently of trace overflow")
	assert(lifecycle[2].stale_display_count == 0, "a cancelled request must not invent a displayed result")

	var no_request_trace := Trace.new()
	var no_request_now := Time.get_ticks_usec()
	no_request_trace.schedule(no_request_now, no_request_now)
	no_request_trace.sample(points, no_request_now)
	no_request_trace.finish_scheduled_inputs(no_request_now + 1)
	var no_request: Dictionary = no_request_trace.scheduled_input_lifecycle()[0]
	assert(no_request.disposition == "sampled_but_superseded")
	assert(no_request.request_count == 0, "sampled poses with no native request stay in the denominator")

	var reused_trace := Trace.new()
	var reused_now := Time.get_ticks_usec()
	reused_trace.schedule(reused_now, reused_now)
	reused_trace.sample(points, reused_now)
	reused_trace.dispatch(1, reused_now, reused_now, true)
	reused_trace.installed(1)
	reused_trace.frame(1, false)
	reused_trace.dispatch(2, reused_now, reused_now, true)
	# A later result for the same sampled input becomes stale after the pointer advances. It must
	# not overwrite the first exact frame or turn an on-time sample into a miss.
	reused_trace.schedule(reused_now + 1, reused_now + 1)
	reused_trace.sample(PackedVector3Array([Vector3.ZERO, Vector3(3, 0, 0)]), reused_now + 1)
	reused_trace.installed(2)
	reused_trace.frame(2, false)
	# Re-sampling the unchanged pose must not manufacture another sampled input.
	reused_trace.schedule(reused_now + 2, reused_now + 2)
	reused_trace.sample(PackedVector3Array([Vector3.ZERO, Vector3(3, 0, 0)]), reused_now + 2)
	reused_trace.finish_scheduled_inputs(Time.get_ticks_usec())
	var reused: Array = reused_trace.scheduled_input_lifecycle()
	assert(reused[0].disposition == "exact_on_time" and reused[0].strict_16_7_met)
	assert(reused[0].request_count == 2 and reused[0].additional_display_count == 1)
	assert(reused[1].disposition == "sampled_but_superseded")
	assert(reused[2].disposition == "coalesced_before_sampling")
	assert(Trace.meets_strict_deadline_us(16699))
	assert(not Trace.meets_strict_deadline_us(16700), "exactly 16.7 ms does not meet a less-than target")

	var late_trace := Trace.new()
	var late_now := Time.get_ticks_usec()
	late_trace.schedule(late_now - 30000, late_now - 30000)
	late_trace.sample(points, late_now - 25000)
	late_trace.dispatch(1, late_now - 24000, late_now - 23000, true)
	late_trace.installed(1)
	late_trace.frame(1, false)
	late_trace.finish_scheduled_inputs(Time.get_ticks_usec())
	var late: Dictionary = late_trace.scheduled_input_lifecycle()[0]
	assert(late.disposition == "late_exact" and not late.strict_16_7_met)
	assert(late.sample_to_frame_ms > 16.7)

	var overflow_trace := Trace.new()
	for index in range(Trace.CAPACITY + 1):
		overflow_trace.schedule(index, index)
	assert(overflow_trace.dropped_lifecycle == 1)
	assert(overflow_trace.dropped == 0 and overflow_trace.dropped_frames == 0)
	print("road_preview_metrics_test: PASS")
	quit()
